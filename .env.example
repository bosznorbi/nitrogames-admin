# --- Alap ---
PORT=3000
NODE_ENV=development

# Admin belepes jelszo (VALTOZTASD MEG!)
ADMIN_PASSWORD=nitrogames2026

# Sutik alairasahoz hasznalt titok (hosszu veletlen string)
SESSION_SECRET=valtoztasd-meg-egy-hosszu-veletlen-ertekre

# Adatok helye. Railwayen a mountolt volume utvonala, pl. /data
DATA_DIR=./data

# Nyilvanos alap URL - a QR kodok ezzel generalodnak.
# Localhoston hagyd uresen (automatikusan a keresbol szarmaztatjuk),
# Railwayen allitsd be, pl. https://nitrogames.up.railway.app
PUBLIC_BASE_URL=

# Esemeny neve (fejlecben latszik)
EVENT_NAME=Nitrogames

# Hattérkep kovetelmenyek (a csapat API ezt kenyszeriti ki)
BG_WIDTH=1080
BG_HEIGHT=1920
LOGO_WIDTH=512
LOGO_HEIGHT=512
MAX_UPLOAD_BYTES=4194304
