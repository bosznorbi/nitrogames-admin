# --- Alap ---
PORT=3000
NODE_ENV=development

# Admin belepes jelszo (VALTOZTASD MEG!)
ADMIN_PASSWORD=nitrogames2026

# Sutik alairasahoz hasznalt titok (hosszu veletlen string)
